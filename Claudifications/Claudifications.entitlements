<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Click-to-jump drives iTerm2 with NSAppleScript. Under the hardened
         runtime that is blocked outright without this entitlement — the app
         would never even reach the TCC prompt the README describes. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
